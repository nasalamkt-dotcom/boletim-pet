# Endereço público do app (sem barra no final). Em produção: https://seu-dominio.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: só no servidor, nunca exponha no navegador
SUPABASE_SERVICE_ROLE_KEY=

# Fuso horário padrão das creches
APP_TIMEZONE=America/Recife

# WhatsApp: "mock" (simulado, padrão) ou "cloud" (API oficial da Meta)
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Token que você inventa para validar o webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# App secret do app na Meta: valida que o webhook veio mesmo da Meta
WHATSAPP_APP_SECRET=
# Nomes dos modelos de mensagem aprovados na Meta
WHATSAPP_TEMPLATE_BOLETIM=boletim_pronto
# Opcional: deixe vazio para não avisar a chegada
WHATSAPP_TEMPLATE_CHEGADA=
WHATSAPP_TEMPLATE_LANG=pt_BR

# Protege a rota do envio automático diário (a Vercel envia esse valor sozinha)
CRON_SECRET=

# Opcional: melhora o recado da equipe com IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
